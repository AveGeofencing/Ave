DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5431/geofencedb
ALEMBIC_DATABASE_URL=postgresql+psycopg://admin:password@localhost:5431/geofencedb

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ECHO_SQL=false
WANT_SINGLE_SIGNIN=false
BASE_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000

AWS_REGION=us-east-1
S3_REGION=eu-west-2
S3_BUCKET=ave-base-bucket
MAX_PHOTO_BYTES=5242880

MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true
